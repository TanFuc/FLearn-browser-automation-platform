# FB Auto Invite - Environment Configuration
# Copy this file to .env and customize values

# ========== Chrome/Browser Settings ==========
# Leave empty for auto-detection, or set explicit paths:
# CHROMEDRIVER_PATH=C:\Tools\chromedriver.exe
CHROMEDRIVER_PATH=
# CHROME_BINARY_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_BINARY_PATH=
# Chrome profile storage directory (defaults to ~/ChromeProfiles)
PROFILE_DIR=
HEADLESS=false
USER_AGENT_ROTATE=true
DISABLE_IMAGES=false
WINDOW_SIZE=1280,720

# ========== Batch Processing Settings ==========
BATCH_SIZE=5
MAX_CLICKS=50
MAX_SCROLLS=100
MAX_RETRIES=3

# ========== Sequential Processing ==========
CONCURRENT_BROWSERS=2
CLOSE_BROWSER_AFTER_ACCOUNT=true
REST_BETWEEN_ACCOUNTS=30

# ========== Daily Limits & Anti-Ban ==========
DAILY_MAX_INVITES=100
WARMUP_ENABLED=true
WARMUP_INITIAL_LIMIT=10

# ========== Timing Settings (seconds) ==========
SCROLL_PAUSE_MIN=3.5
SCROLL_PAUSE_MAX=6.0
CLICK_DELAY_MIN=1.8
CLICK_DELAY_MAX=5.0
BATCH_REST_MIN=90
BATCH_REST_MAX=180

# ========== Anti-Detection Settings ==========
HUMAN_TYPING_ENABLED=true
RANDOM_MOUSE_MOVEMENTS=true
ACTION_DELAY_MIN=2.0
ACTION_DELAY_MAX=5.0
SCROLL_VARIATION=true
RANDOM_BREAKS_ENABLED=true
BREAK_CHANCE_PERCENT=10
BREAK_DURATION_MIN=30
BREAK_DURATION_MAX=120

# ========== Scheduler Settings ==========
SCHEDULER_ENABLED=false
SCHEDULER_START_TIME=08:00
SCHEDULER_END_TIME=22:00
SCHEDULER_PAUSE_DAYS=["Sunday"]

# ========== Auto Loop Settings ==========
AUTO_LOOP_ENABLED=false
AUTO_LOOP_INTERVAL_MINUTES=60
AUTO_LOOP_MAX_RUNS=0

# ========== Filtering Settings ==========
SKIP_ADMINS=true
SKIP_VERIFIED=false
KEYWORDS_BLACKLIST=["shop", "store", "sell"]

# ========== Proxy Settings ==========
USE_PROXY=false
PROXY_FALLBACK_TO_DIRECT=false
PROXY_TEST_TIMEOUT=12
PROXY_MAX_THREADS=60
PROXY_MAX_RUNTIME=600
PROXY_NEEDED_COUNT=5
PROXY_RETRY_COUNT=3

# ========== Telegram Notifications ==========
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ON_COMPLETE=true
NOTIFY_ON_CHECKPOINT=true

# ========== File Paths ==========
ACCOUNT_STATUS_FILE=account_status.json
DATABASE_FILE=fb_auto_invite.db
LOG_FILE=app.log

# ========== Debug & Testing ==========
DEBUG_MODE=false
DRY_RUN=false
AUTO_RETRY_ERRORS=true
MAX_RETRY_PER_RUN=2
